<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>DeepSigma.DataAccess.Web</Title>
    <Authors>DeepSigma LLC</Authors>
    <Description>Web-communication clients for DeepSigma applications: HTTP (JSON/CSV/XML read and write verbs, streaming downloads), plus throttle/retry handlers and shared reconnection policy. Server-Sent Events and WebSocket clients are being added.</Description>
    <PackageDescription>Web-communication clients for DeepSigma applications: HTTP (JSON/CSV/XML read and write verbs, streaming downloads), plus throttle/retry handlers and shared reconnection policy. Server-Sent Events and WebSocket clients are being added.</PackageDescription>
    <PackageProjectUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.DataAccess</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DeepSigma-LLC/Dotnet.DeepSigma.DataAccess</RepositoryUrl>
    <PackageId>DeepSigma.DataAccess.Web</PackageId>
    <AssemblyName>DeepSigma.DataAccess.Web</AssemblyName>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <Version>3.0.0</Version>
    <FileVersion>$(Version)</FileVersion>
    <RootNamespace>DeepSigma.DataAccess.Web</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <PackageIcon>DeepSigma.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\Assets\DeepSigma.png" Link="DeepSigma.png" Pack="True" PackagePath="\" />
    <None Include="README.md" Pack="True" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeepSigma.Core" Version="2.0.0" />
    <PackageReference Include="DeepSigma.DataAccess.CsvUtilities" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
  </ItemGroup>

</Project>
